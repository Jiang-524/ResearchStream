---
import { type Entry, entryUrl, sectionNames, thumbnail, minutes } from '../lib/content';
import I18n from './I18n.astro';
import Icon from './Icon.astro';
import { readExperimentProject } from '../lib/experiments.mjs';
interface Props { entry: Entry; image?: boolean; }
const { entry, image = false } = Astro.props;
const cover = image ? thumbnail(entry) : null;
const project = entry.collection === 'experimentrecord' ? readExperimentProject(entry) : null;
const displayDate = project ? entry.data.updated || entry.data.date : entry.data.date;
---
<a href={entryUrl(entry)} class:list={['entry-card', { 'has-image': !!cover }]}>
  {cover && <div class="card-image"><img src={cover} alt="" loading="lazy"/></div>}
  <div class="card-content">
    <div class="card-eyebrow"><span>{sectionNames[entry.collection]}</span>{entry.data.demo && <span class="sample-mark"><I18n en="SAMPLE" zh="示例"/></span>}</div>
    <h3 title={entry.data.title}>{entry.data.title}</h3>
    <p class="abstract" title={entry.data.abstract}>{entry.data.abstract}</p>
    {project && <div class="experiment-badges">{entry.data.experimentKinds?.map(kind=><span class:list={['experiment-badge',kind]}><I18n en={kind==='reproduction'?'Reproduction':'Improvement'} zh={kind==='reproduction'?'复现':'改进'}/></span>)}<span>{project.experiments.length} <I18n en="runs" zh="次实验"/></span></div>}
    <div class="card-meta">{project && <I18n en="UPDATED" zh="更新"/>}<time datetime={displayDate}>{displayDate.replaceAll('-', '.')}</time><span class="meta-dot">·</span><span>{minutes(entry)} <I18n en="MIN READ" zh="分钟阅读"/></span><Icon name="arrow" size={16}/></div>
  </div>
</a>
