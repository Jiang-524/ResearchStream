---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import I18n from '../../components/I18n.astro';
import Icon from '../../components/Icon.astro';
import { allEntries, entryUrl, url, sectionNames, minutes, type Entry } from '../../lib/content';
export async function getStaticPaths() {
  const entries = await allEntries();
  return entries.map(entry => ({ params: { section: entry.collection, slug: entry.id }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props as { entry: Entry; entries: Entry[] };
const { Content, headings } = await render(entry);
const contents = headings.filter(h => h.depth >= 2 && h.depth <= 3 && !h.slug.includes('footnote-label'));
const related = entries.filter(e => e.collection === entry.collection && (!entry.data.series || e.data.series === entry.data.series));
if (entry.data.series) related.sort((a,b) => (a.data.order || 0) - (b.data.order || 0));
const position = related.findIndex(e => e.id === entry.id);
const previous = related[position - 1], next = related[position + 1];
const translation = entry.data.translationKey ? entries.find(e => e.data.translationKey === entry.data.translationKey && e.data.lang !== entry.data.lang) : null;
---
<Base title={entry.data.title} description={entry.data.abstract} active={entry.collection}>
  <div class="breadcrumb"><a href={url(entry.collection + '/')}>{sectionNames[entry.collection]}</a><span>/</span><span>{entry.data.topic}</span></div>
  <div class="reading-layout">
    <article class="article" lang={entry.data.lang === 'zh' ? 'zh-CN' : 'en'} data-article>
      <header class="article-header"><div class="eyebrow"><I18n en="FIELD NOTE" zh="阅读与学习手记"/><span>·</span><time datetime={entry.data.date}>{entry.data.date.replaceAll('-', '.')}</time><span>·</span><span>{minutes(entry)} <I18n en="MIN READ" zh="分钟阅读"/></span></div><h1>{entry.data.title}</h1>
        <div class="article-tags">{entry.data.tags.map(tag => <a href={`${url('search/')}?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}<span class="original-lang">{entry.data.lang === 'zh' ? '中文原文' : 'English original'}</span>{translation && <a href={entryUrl(translation)} data-translation={entry.data.lang === 'zh' ? 'en' : 'zh'}><I18n en="Read translation" zh="阅读译文"/></a>}</div>
        {entry.data.demo && <p class="sample-notice"><I18n en="Sample entry · for exploring the reading experience." zh="示例文章 · 用于体验阅读与排版，非个人研究记录。"/></p>}
        <div class="article-abstract"><span class="eyebrow">ABSTRACT</span><p>{entry.data.abstract}</p></div>
        {entry.data.paper?.url && <a class="paper-source" href={entry.data.paper.url} target="_blank" rel="noopener noreferrer"><Icon name="book" size={17}/><I18n en="Original paper" zh="论文原文"/><span>{entry.data.paper.title}</span><span>↗</span></a>}
      </header>
      <details class="mobile-toc"><summary><I18n en="On this page" zh="文章目录"/><Icon name="down" size={16}/></summary><nav>{contents.map(h => <a href={`#${h.slug}`} class:list={{ nested: h.depth === 3 }}>{h.text}</a>)}</nav></details>
      <div class="prose"><Content/></div>
      <footer class="article-end"><span class="end-mark">∿</span><p><I18n en="A note to return to." zh="留一份记录，等下一次回看。"/></p><a class="text-link" href="#main"><I18n en="Back to top" zh="回到顶部"/>↑</a></footer>
      <nav class="adjacent-posts" aria-label="Adjacent entries">{previous ? <a href={entryUrl(previous)}><span><I18n en="PREVIOUS NOTE" zh="上一篇"/></span><h3>{previous.data.title}</h3></a> : <div/>}{next ? <a href={entryUrl(next)}><span><I18n en="NEXT NOTE" zh="下一篇"/></span><h3>{next.data.title}</h3></a> : <div/>}</nav>
    </article>
    <aside class="desktop-toc"><div class="toc-inner"><span class="eyebrow"><I18n en="ON THIS PAGE" zh="文章目录"/></span><nav>{contents.map((h, i) => <a href={`#${h.slug}`} class:list={{ nested: h.depth === 3, selected: i === 0 }}><span class="toc-number">{String(i + 1).padStart(2, '0')}</span>{h.text}</a>)}</nav><a class="back-to-archive" href={url(entry.collection + '/')}><Icon name="left" size={14}/><I18n en="Back to archive" zh="返回列表"/></a><span class="reading-progress"><span id="reading-progress"></span></span></div></aside>
  </div>
</Base>
